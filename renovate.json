{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "osvVulnerabilityAlerts": true,
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "vulnerabilityAlerts": {
    "groupName": "security updates"
  },
  "forkProcessing": "enabled",
  "packageRules": [
    {
      "description": "Go indirect modules are ignored by Renovate by default; update them in one grouped weekly PR (go mod tidy runs after updates)",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "indirect"
      ],
      "enabled": true,
      "groupName": "go indirect dependencies",
      "schedule": [
        "before 6am on monday"
      ]
    }
  ]
}
